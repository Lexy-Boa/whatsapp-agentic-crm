# ============================================================
# APPLICATION
# ============================================================
ENVIRONMENT=dev                  # dev | staging | prod
DEBUG=false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
POSTGRES_HOST=localhost          # Use "postgres" inside Docker Compose
POSTGRES_PORT=5432
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password   # Use a strong password in production
POSTGRES_DB=fashion_crm

# Connection pool (tune for your workload)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ============================================================
# REDIS (session cache + dedup)
# ============================================================
REDIS_HOST=localhost             # Use "redis" inside Docker Compose
REDIS_PORT=6379
REDIS_PASSWORD=                  # Leave empty for local dev; required in prod
REDIS_DB=0

# ============================================================
# VECTOR STORE (Qdrant)
# ============================================================
QDRANT_HOST=localhost            # Use "qdrant" inside Docker Compose
QDRANT_PORT=6333
QDRANT_API_KEY=                  # Required when using Qdrant Cloud
QDRANT_COLLECTION=products

# ============================================================
# AI SERVICES
# ============================================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx

# Claude model and generation settings
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# Groq (Whisper transcription)
GROQ_API_KEY=gsk_xxxxx
WHISPER_PROVIDER=groq
WHISPER_MODEL=whisper-large-v3-turbo

# OpenAI (text embeddings only)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# WHATSAPP (Meta Cloud API)
# ============================================================
WHATSAPP_ACCESS_TOKEN=your_meta_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=100320015621xxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=946334921xxxxx
WHATSAPP_PHONE_NUMBER=+919876543210

# Webhook security
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token
WHATSAPP_APP_SECRET=your_meta_app_secret_for_signature_verification

# Outbound policy
WHATSAPP_POLICY_MODE=warn               # off | warn | enforce
WHATSAPP_CUSTOMER_SERVICE_WINDOW_HOURS=24

# ============================================================
# SHOPIFY
# ============================================================
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# ============================================================
# STORE CONFIGURATION
# ============================================================
# Generated by: python -m scripts.setup_store ...
# Set this after running setup_store.py for the first time
STORE_ID=

# ============================================================
# QUEUE RECOVERY
# ============================================================
QUEUE_PROCESSING_TIMEOUT_SECONDS=180
QUEUE_RECOVERY_INTERVAL_SECONDS=30
QUEUE_MAX_RECOVERY_ATTEMPTS=3

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
