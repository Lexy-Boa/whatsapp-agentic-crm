      "expected_handoff": "conditional",
      "required_tags": [
        "payment_policy_unknown",
        "must_not_claim_cod",
        "team_must_confirm"
      ],
      "forbidden_tags": [
        "can_auto_answer_policy"
      ]
    },
    {
